# Supabase project: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used to build links in transactional auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a dedicated account for the authenticated Playwright journey
# (e2e/authenticated/). Without these the journey skips itself rather than
# failing. Use a throwaway account, never your own: the specs create and delete
# real projects in whichever Supabase project is configured above.
E2E_EMAIL=
E2E_PASSWORD=
